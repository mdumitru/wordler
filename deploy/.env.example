# Copy to deploy/.env (git-ignored) and fill in.

# The public domain; Caddy fetches its certificate automatically once DNS
# points here and ports 80/443 are open. Use :80 for a plain-HTTP local test.
SITE_ADDRESS=wordler.example.com

# Generate both with: openssl rand -hex 32
# (hex keeps the password safe inside the database URL)
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=

# Created in the Umami dashboard after the first start; empty = analytics off.
UMAMI_WEBSITE_ID=
